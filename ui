local function getWeaponPosition()
    local character = LocalPlayer.Character
    if not character then return nil end
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        local part = tool:FindFirstChild("Handle") or tool:FindFirstChild("Barrel") or tool
        return part.Position
    end
    local rightArm = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if rightArm then return rightArm.Position end
    return nil
end

local function enhanceExistingTrails(obj)
    if obj:IsA("Trail") then
        obj.WidthScale = NumberSequence.new(TracerSettings.Width)
        obj.Lifetime = TracerSettings.Lifetime
        obj.Transparency = NumberSequence.new(0)
        obj.Color = ColorSequence.new(TracerSettings.Color)
        obj.LightEmission = 1
        obj.LightInfluence = 0
        obj.FaceCamera = true
    elseif obj:IsA("Beam") then
        obj.Width0 = TracerSettings.Width
        obj.Width1 = TracerSettings.Width
        obj.Color = ColorSequence.new(TracerSettings.Color)
        obj.Transparency = NumberSequence.new(0)
        obj.LightEmission = 1
        obj.LightInfluence = 0
        obj.FaceCamera = true
        obj.Texture = ""
    end
end

