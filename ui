local function ShouldDisplay(plr)
    if plr == LocalPlayer then return false end
    if not ESP_SETTINGS.UseTeamCheck then return true end
    local myChar = LocalPlayer.Character
    local theirChar = plr.Character
    if not myChar or not theirChar then return false end
    local myParent = myChar.Parent
    local theirParent = theirChar.Parent
    if not myParent or not theirParent then return false end
    local isEnemy = myParent.Name ~= theirParent.Name
    if ESP_SETTINGS.TeamCheckMode == "Enemies" then
        return isEnemy
    elseif ESP_SETTINGS.TeamCheckMode == "Teammates" then
        return not isEnemy
    else
        return true
    end
end

local function CreateESP(plr)
    if ESPObjects[plr] then return end
    local objs = {}
    local lines = {}
    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Thickness = ESP_SETTINGS.Thickness
        line.Color = ESP_SETTINGS.Color
        line.Visible = false
        table.insert(lines, line)
    end
    objs.lines = lines
    if ESP_SETTINGS.Name then
        local name = Drawing.new("Text")
        name.Size = 15
        name.Center = true
        name.Outline = true
        name.Color = ESP_SETTINGS.NameColor
        name.Visible = false
        objs.Name = name
    end
    if ESP_SETTINGS.Distance then
        local dist = Drawing.new("Text")
        dist.Size = 12
        dist.Center = true
        dist.Outline = true
        dist.Color = ESP_SETTINGS.DistanceColor
        dist.Visible = false
        objs.Distance = dist
    end
    if ESP_SETTINGS.HealthBar then
        local bg = Drawing.new("Square")
        bg.Filled = true
        bg.Color = ESP_SETTINGS.HealthBgColor
        bg.Visible = false
        objs.HealthBg = bg
        local fill = Drawing.new("Square")
        fill.Filled = true
        fill.Color = ESP_SETTINGS.HealthColor
        fill.Visible = false
        objs.HealthFill = fill
    end
    ESPObjects[plr] = objs
end

local function RemoveESP(plr)
    local objs = ESPObjects[plr]
    if objs then
        for _, line in ipairs(objs.lines) do line:Remove() end
        if objs.Name then objs.Name:Remove() end
        if objs.Distance then objs.Distance:Remove() end
        if objs.HealthBg then objs.HealthBg:Remove() end
        if objs.HealthFill then objs.HealthFill:Remove() end
        ESPObjects[plr] = nil
    end
end

