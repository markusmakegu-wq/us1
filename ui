local function IsEnemy(plr)
    if plr == LocalPlayer then return false end
    local myChar = LocalPlayer.Character
    local theirChar = plr.Character
    if not myChar or not theirChar then return false end
    local myParent = myChar.Parent
    local theirParent = theirChar.Parent
    if not myParent or not theirParent then return false end
    return myParent.Name ~= theirParent.Name
end

local function RemoveAdorns(part)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child.Name == "Chams" or child.Name == "Glow" then
            child:Destroy()
        end
    end
end

local function CreateSimpleCham(part, color, trans)
    local cham = Instance.new("BoxHandleAdornment")
    cham.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
    cham.Adornee = part
    cham.AlwaysOnTop = true
    cham.ZIndex = 10
    cham.Color3 = color
    cham.Transparency = trans or 0
    cham.Name = "Chams"
    cham.Parent = part
    return cham
end

local function UpdateChams()
    for _, plr in Players:GetPlayers() do
        local char = plr.Character
        if char then
            for _, part in char:GetChildren() do
                if part:IsA("BasePart") then RemoveAdorns(part) end
            end
        end
    end
    if not ChamsSettings.Enabled then return end
    for _, plr in Players:GetPlayers() do
        if plr ~= LocalPlayer and plr.Character and IsEnemy(plr) then
            for _, part in plr.Character:GetChildren() do
                if part:IsA("BasePart") and part.Transparency < 1 then
                    CreateSimpleCham(part, ChamsSettings.Color, ChamsSettings.Transparency)
                end
            end
        end
    end
end

local ChamsUpdateRunning = false
local function StartChamsLoop()
    if ChamsUpdateRunning then return end
    ChamsUpdateRunning = true
    coroutine.wrap(function()
        while true do
            if ChamsSettings.Enabled then
                UpdateChams()
            end
            task.wait(0.2 + math.random() * 0.1)
        end
    end)()
end
StartChamsLoop()

