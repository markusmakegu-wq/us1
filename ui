local function getKeyEnum(keyName)
    if keyName == "Alt" then return Enum.KeyCode.LeftAlt
    elseif keyName == "X" then return Enum.KeyCode.X
    elseif keyName == "Mouse2" then return Enum.UserInputType.MouseButton2
    else return Enum.KeyCode.LeftAlt
    end
end

local SilentAimKeyConnection = nil
local function setupSilentAimKeybind()
    if SilentAimKeyConnection then SilentAimKeyConnection:Disconnect() end
    SilentAimKeyEnum = getKeyEnum(SilentAimKeybind)
    SilentAimKeyConnection = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        local isKey = (input.KeyCode == SilentAimKeyEnum) or (input.UserInputType == SilentAimKeyEnum)
        if not isKey then return end
        if SilentAimKeyMode == "Toggle" then
            CombatSettings.SilentEnabled = not CombatSettings.SilentEnabled
            if uiControls and uiControls.silentToggle then uiControls.silentToggle(CombatSettings.SilentEnabled) end
        elseif SilentAimKeyMode == "Hold" then
            if not SilentAimHoldOverride then
                OriginalSilentState = CombatSettings.SilentEnabled
                CombatSettings.SilentEnabled = true
                if uiControls and uiControls.silentToggle then uiControls.silentToggle(true) end
                SilentAimHoldOverride = true
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        local isKey = (input.KeyCode == SilentAimKeyEnum) or (input.UserInputType == SilentAimKeyEnum)
        if not isKey then return end
        if SilentAimKeyMode == "Hold" and SilentAimHoldOverride then
            CombatSettings.SilentEnabled = OriginalSilentState
            if uiControls and uiControls.silentToggle then uiControls.silentToggle(OriginalSilentState) end
            SilentAimHoldOverride = false
        end
    end)
end
